# ============================================
# IDX AI Signal Bot - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/idx_signal_bot
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/idx_signal_bot

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- LLM API Keys ---
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=claude  # claude or gemini

# --- TradingView Webhook ---
TRADINGVIEW_WEBHOOK_SECRET=your_webhook_secret_here

# --- Supabase (Broker Summary) ---
SUPABASE_PROJECT_ID=your_supabase_project_id_here
SUPABASE_API_KEY=your_supabase_api_key_here
SUPABASE_URL=https://your_supabase_project_id_here.supabase.co

# --- App Settings ---
APP_ENV=development  # development, staging, production
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Google Spreadsheet (SPS) Recap ---
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec
GOOGLE_SHEET_VIEW_URL=https://docs.google.com/spreadsheets/d/.../edit

# --- Data Provider ---
DATA_PROVIDER=mock  # mock, csv, api
CSV_DATA_DIR=./data/csv

# --- Liquidity Thresholds ---
MIN_VALUE_BUY=500000000       # Rp500 juta
MIN_VALUE_CONFIDENCE=1000000000  # Rp1 miliar
MIN_FREQUENCY=50

# --- Backtest Settings ---
BACKTEST_MIN_SAMPLE=30
BACKTEST_MIN_WINRATE=70
BACKTEST_HIGH_WINRATE=80
MAX_HOLDING_PERIOD=10
